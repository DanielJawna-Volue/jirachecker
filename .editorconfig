# https://editorconfig.org — honoured by VS Code, GoLand, Vim and most other editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt uses tabs.
[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum,Makefile}]
indent_style = tab
indent_size = 4

# Trailing double spaces are meaningful line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
