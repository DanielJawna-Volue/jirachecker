# Store and check out all text files with LF line endings, on every OS,
# regardless of the user's core.autocrlf setting. gofmt emits LF.
* text=auto eol=lf

*.go     text eol=lf diff=golang
go.mod   text eol=lf
go.sum   text eol=lf merge=union
*.md     text eol=lf diff=markdown
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf

# Windows scripts need CRLF to run correctly.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files: never touch line endings, never diff as text.
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.zip    binary
*.gz     binary
